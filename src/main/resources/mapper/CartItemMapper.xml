            <result property="goodsSn" column="goods_sn" jdbcType="VARCHAR"/>
            <result property="goodsAttr" column="goods_attr" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,goods_id,goods_sku_id,
        member_id,member_nickname,quantity,
        price,goods_pic,goods_name,
        goods_sub_title,goods_sku_code,create_time,
        update_time,is_deleted,goods_category_id,
