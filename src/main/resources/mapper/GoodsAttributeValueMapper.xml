<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jommo.mapper.GoodsAttributeValueMapper">

    <resultMap id="BaseResultMap" type="com.jommo.domain.GoodsAttributeValue">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="goodsId" column="goods_id" jdbcType="BIGINT"/>
        <result property="goodsAttributeId" column="goods_attribute_id" jdbcType="BIGINT"/>
        <result property="value" column="value" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,goods_id,goods_attribute_id,
        value
    </sql>
    <insert id="insertList">
        insert into goods_attribute_value(id, goods_id, goods_attribute_id, value)
        VALUES
        <foreach collection="list" index="index" item="item" separator=",">
            (#{item.id,jdbcType=BIGINT},#{item.goodsId,jdbcType=BIGINT}, #{item.goodsAttributeId,jdbcType=BIGINT},
            #{item.value,jdbcType=VARCHAR})
        </foreach>
    </insert>
</mapper>
